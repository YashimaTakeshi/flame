{
  "name": "flame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:verify && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:fonts": "python3 scripts/build-fonts.py",
    "assets:icons": "python3 scripts/build-icons.py",
    "assets:film": "python3 scripts/build-film.py",
    "assets:geo": "node scripts/build-geo.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "verify": "npm run assets:verify && npx depcruise --config .dependency-cruiser.cjs src && npx eslint . && npm run typecheck",
    "test:browser": "node tests/browser/runner.mjs",
    "assets:fixtures": "python3 scripts/build-fixtures.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "all-the-cities": "^3.1.0",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "immer": "^11.1.18",
    "piexifjs": "^1.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
